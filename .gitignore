# =======================================================================
# Build Market - Git Ignore Configuration
# =======================================================================

# 1. Environment and Secrets
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.crt

# 2. Dependencies
node_modules/
*/node_modules/
package-lock.json.bak

# 3. Uploads and Media
backend/uploads/*
!backend/uploads/.gitkeep
uploads/
*/uploads/*
!*/uploads/.gitkeep

# 4. Windows Binaries & Local Tools
tools/
*.exe
*.dll
*.msi
*.ps1.bak

# 5. Build Artifacts
dist/
*/dist/
build/
*/build/
out/
*/out/
.vite/

# 6. Backups & Temporary Files
_backup_*/
backups/
*.bak
*.tmp
*.swp
*.swo

# 7. Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 8. OS and Editor Files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
